<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/Hud.uss?fileID=7433441132597879392&amp;guid=001663f9258d34c35a297cad38578acc&amp;type=3#Hud"/>
    <ui:VisualElement name="Root" picking-mode="Ignore" class="hud-root">
        <ui:VisualElement name="LeftGroup" picking-mode="Ignore" class="hud-group">
            <ui:Button name="PauseButton" text="" class="hud-panel hud-pause-button" style="-unity-slice-type: tiled; margin-right: 2px;">
                <ui:VisualElement picking-mode="Ignore" class="hud-icon hud-icon--pause"/>
            </ui:Button>
            <ui:VisualElement picking-mode="Ignore" class="hud-panel" style="padding-left: 8px;">
                <ui:Label text="LVL 1" name="LevelName" picking-mode="Ignore" class="hud-text"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="LevelStats" picking-mode="Ignore" class="hud-panel">
            <ui:VisualElement picking-mode="Ignore" class="hud-icon hud-icon--skull"/>
            <ui:Label text="{0}" name="PlayerDeathCount" picking-mode="Ignore" class="hud-text"/>
            <ui:VisualElement picking-mode="Ignore" class="hud-divider"/>
            <ui:VisualElement picking-mode="Ignore" class="hud-icon hud-icon--clock"/>
            <ui:Label text="{0}" name="ElapsedTime" picking-mode="Ignore" class="hud-text hud-text--time"/>
            <ui:VisualElement picking-mode="Ignore" class="hud-divider"/>
            <ui:VisualElement picking-mode="Ignore" class="hud-icon hud-icon--launch"/>
            <ui:Label text="{0}" name="PlayerLaunchCount" picking-mode="Ignore" class="hud-text"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
